    <div class="container-fluid">
        
      


      <section class="row align-items-stretch photos" id="section-photos">
        <div class="col-12">
        <div class="row align-items-stretch">
        {% for item in picList %}
        <div class="col-6 col-md-6 col-lg-4" data-aos="fade-up">
         <a href="{{headerstuff['baseURLForPhotos']}}{{item.bigurl}}" class="d-block photo-item" data-fancybox="gallery" data-download-src="{{headerstuff['baseURLForPhotos']}}{{item.bigurl}}">
            <div style="position: relative;">
              <img class="lozad" src="{{headerstuff['baseURLForFrontEnd']}}images/placeholder-mand.png" style="object-position: {{item.tnXPos}}% {{item.tnYPos}}%;" data-src="{{headerstuff['baseURLForPhotos']}}{{item.smallurl}}" alt="Image" class="img-fluid">
              <div style="color: #FF00FF; position: absolute; top: {{item.tnYPos}}%; left: {{item.tnXPos}}%; font-size: 40px;">*</div>
              </div>
            <div class="photo-text-more">
              <span class="icon icon-search"></span>
            </div>
          </a>
        </div>
        {% endfor %}

      </div>
        
    </div>
      </section> <!-- #section-photos -->

